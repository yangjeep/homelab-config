[Unit]
Description=LeaseLab bounded verification of root request %i

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/leaselab-publisher-executor/venv/bin/python /usr/local/libexec/leaselab-company/publisher/verification_request.py %i
TimeoutStartSec=300
TimeoutStopSec=10
KillMode=control-group
MemoryMax=1G
TasksMax=96
CPUQuota=100%
PrivateTmp=yes
NoNewPrivileges=yes
