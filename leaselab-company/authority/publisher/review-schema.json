{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "security",
            "correctness"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "kind",
        "severity",
        "explanation",
        "expected",
        "actual"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReviewIdentity": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base",
          "type": "string"
        },
        "head": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head",
          "type": "string"
        },
        "job": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Job",
          "type": "string"
        },
        "policy": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy",
          "type": "string"
        },
        "pr": {
          "exclusiveMinimum": 0,
          "title": "Pr",
          "type": "integer"
        },
        "provenance": {
          "enum": [
            "github",
            "synthetic-fixture"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "repository": {
          "const": "yangjeep/leaselab",
          "title": "Repository",
          "type": "string"
        },
        "source": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "provenance",
        "pr",
        "head",
        "base",
        "policy",
        "source",
        "job"
      ],
      "title": "ReviewIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 20,
      "title": "Findings",
      "type": "array"
    },
    "identity": {
      "$ref": "#/$defs/ReviewIdentity"
    },
    "result": {
      "enum": [
        "clear",
        "findings",
        "inconclusive"
      ],
      "title": "Result",
      "type": "string"
    },
    "summary": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "identity",
    "result",
    "summary",
    "findings"
  ],
  "title": "Disposition",
  "type": "object"
}
