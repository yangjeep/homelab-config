 Port 443
 HostKeyAlias github.com
 User git
 IdentityFile /var/lib/leaselab-backup/keys/github_ed25519
Host leaselab-truenas
 HostName 192.168.253.100
 User hermes-agent-leaselab-backup
 IdentityFile /var/lib/leaselab-backup/keys/truenas_ed25519
Host *
 IdentitiesOnly yes
