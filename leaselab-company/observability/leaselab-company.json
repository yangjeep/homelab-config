{
  "uid": "leaselab-company",
  "title": "AI - LeaseLab Company",
  "description": "Independent LeaseLab Hermes runtime, Kanban aggregates and current OpenRouter role-key usage. Collection health does not establish QA, review, merge or release approval.",
  "schemaVersion": 40,
  "version": 0,
  "editable": true,
  "tags": [
    "homelab",
    "noc"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Homelab dashboards",
      "type": "dashboards",
      "tags": [
        "noc"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "LXC exporter",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "up{host=\"hermes-leaselab\",job=\"observability-node\"}",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name",
        "graphMode": "none",
        "text": {
          "titleSize": 12,
          "valueSize": 24
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
