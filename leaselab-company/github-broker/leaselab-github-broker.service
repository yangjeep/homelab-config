[Unit]
Description=LeaseLab fixed role GitHub credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leaselab-github-broker
Group=leaselab-github-clients
ExecStart=/usr/bin/python3 -I /usr/local/libexec/leaselab-company/github-broker/broker.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=leaselab-github
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=64
TasksMax=16
MemoryMax=128M
ReadWritePaths=/run/leaselab-github

[Install]
WantedBy=multi-user.target
