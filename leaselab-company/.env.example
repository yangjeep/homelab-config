# One private .env per role; values supplied externally. Never commit filled files.
# A distinct profile key in the LeaseLab workspace, aggregate USD 30/month hard cap.
OPENROUTER_API_KEY=
# Unique Slack bot credential for this profile; never share across roles.
SLACK_BOT_TOKEN=
# Unique Socket Mode app credential for this same profile and Slack app.
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=U0225R7NP8Q
SLACK_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
# Telegram is Chief of Staff only, after identity verification:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
# GitHub uses the fixed-UID broker, not a static token here; Engineer remains disabled.
# Growth Google and coding OAuth credentials live in isolated Unix role homes.
# Never put management keys, founder tokens, cloud release secrets or other-role keys here.
