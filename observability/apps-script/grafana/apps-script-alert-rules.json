    "condition": "B",
    "for": "0s",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "annotations": {
      "summary": "An Apps Script execution timed out within 10 minutes. Inspect execution metadata and duration; no script schedule is assumed.",
      "dashboard_url": "https://yangjeep.grafana.net/d/homelab-cloud-apps-script",
      "runbook_url": "https://github.com/yangjeep/homelab-config/tree/main/observability/apps-script"
    },
