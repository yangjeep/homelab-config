        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 1800,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(increase(homelab_apps_script_executions_terminal_total{job=\"apps-script-observer\",status=\"TIMED_OUT\"}[10m])) > bool 0",
          "instant": true,
          "range": false,
          "intervalMs": 30000,
          "maxDataPoints": 43200,
