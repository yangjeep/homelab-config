        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last"
              },
              "type": "query"
            }
