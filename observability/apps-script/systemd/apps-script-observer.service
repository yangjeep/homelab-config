[Unit]
Description=Collect Google Apps Script execution metadata
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apps-script-observer
Group=apps-script-observer
SupplementaryGroups=truenas-exporter
EnvironmentFile=/etc/apps-script-observer.env
ExecStart=/opt/apps-script-observer/.venv/bin/apps-script-observer
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/apps-script-observer
ReadWritePaths=/var/lib/apps-script-observer /var/lib/prometheus/node-exporter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
MemoryMax=128M
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
