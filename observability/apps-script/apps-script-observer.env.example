GOOGLE_OAUTH_CLIENT_CONFIG=/etc/apps-script-observer/client.json
GOOGLE_OAUTH_REFRESH_TOKEN_FILE=/etc/apps-script-observer/refresh-token
APPS_SCRIPT_SCRIPTS=gmail-cleaner=REPLACE_WITH_SCRIPT_ID
APPS_SCRIPT_STATE_PATH=/var/lib/apps-script-observer/state.sqlite3
APPS_SCRIPT_METRICS_PATH=/var/lib/prometheus/node-exporter/apps_script.prom
