          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"openrouter\" && span:name = \"LLM Generation\" } | sum_over_time(span.gen_ai.usage.input_tokens) by(span.trace.metadata.openrouter.api_key_name)",
          "tableType": "traces",
          "limit": 20,
          "metricsQueryType": "range",
          "step": "300s",
          "exemplars": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
