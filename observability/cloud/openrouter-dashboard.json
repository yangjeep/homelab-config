    {
      "id": 9,
      "title": "Mean first-token latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"openrouter\" && span:name = \"LLM Generation\" } | avg_over_time(span.trace.metadata.openrouter.first_token_ms) by(span.trace.metadata.openrouter.api_key_name)",
          "tableType": "traces",
          "limit": 20,
          "metricsQueryType": "range",
          "step": "300s",
          "exemplars": 3
        }
      ],
      "fieldConfig": {
        "defaults": {
