          "query": "{ resource.service.name = \"openrouter\" && span:name = \"LLM Generation\" } | sum_over_time(span.gen_ai.usage.output_tokens) by(span.trace.metadata.openrouter.api_key_name)",
          "tableType": "traces",
          "limit": 20,
