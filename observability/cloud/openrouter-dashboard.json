      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"openrouter\" && span.span.metadata.attempt_index > 0 } | count_over_time() by(span.trace.metadata.openrouter.provider_name)",
          "tableType": "traces",
          "limit": 20,
          "metricsQueryType": "range",
          "step": "300s",
          "exemplars": 3
        }
