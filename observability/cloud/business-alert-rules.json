[
  {
    "uid": "openrouter-root-errors",
    "orgID": 1,
    "folderUID": "homelab-cloud",
    "ruleGroup": "Homelab business signals",
    "title": "OpenRouter sustained root generation errors",
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "annotations": {
      "description": "Operational threshold: at least 3 failed root LLM Generation spans in a rolling 15-minute window, sustained for 5 minutes.",
      "summary": "OpenRouter root generation failures exceeded the 15-minute error budget"
    },
    "labels": {
      "severity": "warning",
      "subsystem": "openrouter"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "traceql",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "grafanacloud-traces",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"openrouter\" && span:name = \"LLM Generation\" && status = error } | count_over_time()",
          "metricsQueryType": "instant",
          "tableType": "traces",
          "limit": 20,
          "exemplars": 0,
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      },
      {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  2
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
